# API
APP_NAME=tienda-angular-backend
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=tienda_angular
POSTGRES_USER=tienda_user
POSTGRES_PASSWORD=change_me

# SQLAlchemy
DATABASE_URL=postgresql+psycopg://tienda_user:change_me@db:5432/tienda_angular

# Auth / JWT (CHANGE IN REAL ENVIRONMENTS)
JWT_SECRET_KEY=change_me_jwt_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
