# API
APP_NAME=tienda-angular-backend
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=tienda_angular
POSTGRES_USER=tienda_user
POSTGRES_PASSWORD=change_me

# SQLAlchemy
DATABASE_URL=postgresql+psycopg://tienda_user:change_me@db:5432/tienda_angular

# Auth / JWT (CHANGE IN REAL ENVIRONMENTS)
JWT_SECRET_KEY=change_me_jwt_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENABLE_AUTH_DIAGNOSTICS=false

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:4200
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,Origin,X-Requested-With

# Auth rate limiting (PostgreSQL-backed, no Redis)
AUTH_RATE_LIMIT_LOGIN_LIMIT=10
AUTH_RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_LOGIN_BLOCK_SECONDS=300
AUTH_RATE_LIMIT_REGISTER_LIMIT=5
AUTH_RATE_LIMIT_REGISTER_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REGISTER_BLOCK_SECONDS=300
AUTH_RATE_LIMIT_REFRESH_LIMIT=20
AUTH_RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REFRESH_BLOCK_SECONDS=300

# Media uploads (local filesystem, Docker volume persistent)
MEDIA_ROOT=/app/media
MEDIA_URL=/media
MEDIA_MAX_UPLOAD_MB=5
